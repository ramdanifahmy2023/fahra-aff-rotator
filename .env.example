HOST=127.0.0.1
PORT=8788
# MCP is separate from the web UI. Keep it on loopback for local-only access;
# the macOS LaunchAgent uses the Mac's Tailscale address for private remote access.
MCP_HOST=127.0.0.1
MCP_PORT=8790
MCP_PUBLIC_URL="http://127.0.0.1:8790/mcp"
# For a reverse SSH tunnel, use the loopback endpoint on the VPS instead:
# MCP_PUBLIC_URL="http://127.0.0.1:18790/mcp"
MCP_ALLOWED_NETWORKS="127.0.0.1/32,100.64.0.0/10,::1/128"
MCP_TOKEN_FILE="data/mcp-openclaw.token"
MCP_TOKEN_NAME=openclaw
MCP_MAX_WAIT_SECONDS=180
MCP_RATE_LIMIT_PER_MINUTE=30
AFFILIATE_DB="data/affiliate.sqlite3"
SHOPEE_COOKIE_FILE="Credential/cookies.txt"
# Optional: JSON exported from the latest /api/v3/gql request captured by XYZ Sniper.
SHOPEE_REQUEST_HEADERS_FILE="Credential/request_headers.json"
MAX_RETRIES=3
WORKER_POLL_SECONDS=0.8
# extension is the default; it uses an already-open, logged-in Shopee tab.
SHOPEE_TRANSPORT=extension
SHOPEE_BRIDGE_WAIT_SECONDS=180
# browser is an optional fallback and opens a dedicated visible profile.
SHOPEE_HEADLESS=false
SHOPEE_BROWSER_PROFILE="data/shopee-browser-profile"
SHOPEE_MANUAL_VERIFY_WAIT_SECONDS=180
# Auth session lasts one day by default. Seed the first password once with:
# SUPERADMIN_EMAIL="ramdanifahmy2023@gmail.com" SUPERADMIN_INITIAL_PASSWORD="..." python3 app.py --bootstrap-admin
AUTH_SESSION_TTL_SECONDS=86400
SUPERADMIN_EMAIL="ramdanifahmy2023@gmail.com"
